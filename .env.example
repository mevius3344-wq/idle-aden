# Neon Postgres（Vercel 部署必填）
# 從 Neon Console 或 neonctl connection-string --pooled 取得
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 可選：雙開限制（預設每 IP 最多 2 連線）
# IP_SESSION_LIMIT=1
# IP_SESSION_MAX=2
# IP_SESSION_TTL_MS=45000

# 可選：全服金幣／掉寶倍率（登入頁顯示並套用於打怪）
# SERVER_GOLD_MULT=1
# SERVER_DROP_MULT=1
