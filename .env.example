# 遊戲主機（Railway）公開網址；部署後填入，供 HTML 注入／本機對照
# PUBLIC_GAME_ORIGIN=https://game-production-b224.up.railway.app

# Neon Postgres（Vercel 部署必填）
# 從 Neon Console 或 neonctl connection-string --pooled 取得
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# 必要：登入 token 簽章密鑰（至少 16 字元；正式環境務必自訂，勿用預設）
# AUTH_SECRET=請自行設定很長的隨機字串

# 可選：封測公告／IP 連線上限（預設每 IP 最多 1 連線；CLOSED_BETA=0 可關公告）
# CLOSED_BETA=1
# SERVER_NOTICE=【封測／測試服】本服僅供測試，會不定期清檔，經濟與進度不保證保留。
# IP_SESSION_LIMIT=1
# IP_SESSION_MAX=1
# IP_SESSION_TTL_MS=45000

# 可選：全服金幣／掉寶倍率（登入頁顯示並套用於打怪）
# SERVER_GOLD_MULT=1
# SERVER_DROP_MULT=1

# 可選：監控面板 admin-metrics.html 驗證用（至少 8 字元；請設於 Vercel 與 Railway）
# METRICS_TOKEN=請自行設定長密碼
